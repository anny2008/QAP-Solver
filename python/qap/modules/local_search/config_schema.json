{
  "title": "Local Search Configuration",
  "description": "Schema for heuristic local search methods",
  "type": "object",
  "properties": {
    "solver": {
      "type": "string",
      "enum": ["local_search"],
      "description": "Solver/method to use"
    },
    "method": {
      "type": "string",
      "enum": ["tabu_search", "simulated_annealing", "genetic_algorithm"],
      "description": "Heuristic method"
    },
    "time_limit": {
      "type": "number",
      "minimum": 0,
      "description": "Time limit in seconds"
    },
    "initial_solution": {
      "type": "string",
      "enum": ["random", "greedy"],
      "description": "How to initialize the solution"
    },
    "seed": {
      "type": "integer",
      "description": "Random seed for reproducibility"
    }
  },
  "required": ["solver", "method"]
}
